---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PasswordField from "../components/auth/PasswordField.astro";
import { getActor } from "../server/auth";
import { listSellablePackages } from "../server/billing";
import { formatRupiah } from "../modules/billing/catalog";
import "../styles/auth.css";

// Tombol "Mulai sekarang" di halaman harga membawa `?paket=<id>`; hanya id
// berbentuk wajar yang diteruskan, dan hanya paket yang memang dijual.
const requested = (Astro.url.searchParams.get("paket") ?? "").toLowerCase();
const chosen = /^[a-z0-9-]{1,40}$/.test(requested)
  ? (await listSellablePackages()).find((p) => p.id === requested)
  : undefined;
const next = chosen
  ? `/dashboard/paket?paket=${encodeURIComponent(chosen.id)}`
  : "/dashboard";
Astro.response.headers.set("Cache-Control", "private, no-store");
if (await getActor(Astro.request)) return Astro.redirect(next);
---

<BaseLayout title="Daftar — Temu" noindex>
  <main class="login-shell">
    <a href="/" class="login-brand">
      temu.
    </a>
    <section class="login-card">
      <span class="kicker">MULAI DARI SINI</span>
      <h1>
        Buat undangan
        <br />
        <em>kalian.</em>
      </h1>
      <p>
        Daftar untuk mulai menyusun undangan, daftar tamu, dan anggaran
        pernikahan di ruang kerja milik sendiri.
      </p>
      {chosen && (
        <p class="chosen-package" role="note">
          Paket pilihan: <strong>{chosen.name}</strong> (
          {formatRupiah(chosen.price)}). Setelah mendaftar Anda langsung
          diarahkan ke pembayarannya.
        </p>
      )}
      <form id="register-form" data-next={next}>
        <div class="field">
          <label>
            Nama
            <input
              required
              type="text"
              name="name"
              autocomplete="name"
              minlength="2"
              maxlength="100"
            />
          </label>
        </div>
        <div class="field">
          <label>
            Email
            <input required type="email" name="email" autocomplete="email" />
          </label>
        </div>
        <div class="field">
          <label>
            Nomor WhatsApp (opsional)
            <input type="tel" name="phone" autocomplete="tel" maxlength="30" />
          </label>
        </div>
        <PasswordField
          label="Kata sandi"
          name="password"
          autocomplete="new-password"
          minlength={8}
          hint="Minimal 8 karakter."
        />
        <p id="register-error" class="form-msg" role="alert"></p>
        <button type="submit">
          Buat akun <Icon name="arrow" size={18} />
        </button>
      </form>
      <p class="switch">
        Sudah punya akun? <a href="/login">Masuk</a>
      </p>
      <a class="back" href="/">
        Kembali ke beranda
      </a>
    </section>
    <span class="login-bottom">CERITA INDAH DIMULAI DARI SINI.</span>
  </main>
</BaseLayout>
<style>
  .chosen-package {
    background: #eef0e4;
    border: 1px solid #d3d9c2;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.6;
    color: #3f4a35;
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>("#register-form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("[type=submit]")!;
    const error = document.querySelector<HTMLElement>("#register-error")!;
    button.disabled = true;
    error.textContent = "";
    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      window.location.href = form.dataset.next || "/dashboard";
    } catch (e) {
      error.textContent =
        e instanceof Error ? e.message : "Tidak dapat mendaftar. Coba lagi.";
      button.disabled = false;
    }
  });
</script>
