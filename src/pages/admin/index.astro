---
import AdminLayout from "../../layouts/AdminLayout.astro";
import RevenueChart from "../../components/admin/RevenueChart.astro";
import "../../components/admin/admin-ui.css";
import { formatDate } from "../../components/admin/format";
import { formatRupiah } from "../../modules/billing/catalog";
import { adminPage } from "../../server/admin-page";
import { getOverview } from "../../server/admin";
import { salesReadiness } from "../../modules/admin/readiness";
import { readGlobal } from "../../modules/invitations/infrastructure/global-store";

const guard = await adminPage(Astro);
if (guard instanceof Response) return guard;
const actor = guard;
const m = await getOverview(actor);
const readiness = salesReadiness(await readGlobal());
const pending = readiness.filter((item) => !item.done);
const requiredPending = pending.filter((item) => item.level === "required");
const kpis = [
  {
    label: "Pelanggan",
    value: m.totalCustomers,
    sub: `${m.newLast7Days} baru 7 hari, ${m.newLast30Days} baru 30 hari`,
    href: "/admin/pelanggan",
  },
  {
    label: "Paket berbayar aktif",
    value: m.activePaid,
    sub: `${m.expiringSoon} berakhir dalam 14 hari`,
    href: "/admin/pelanggan?filter=active",
  },
  {
    label: "Uji coba",
    value: m.trial,
    sub: `${m.expired} kedaluwarsa`,
    href: "/admin/pelanggan?filter=trial",
  },
  {
    label: "Undangan terbit",
    value: m.publishedInvitations,
    sub: m.invitationCountsPartial
      ? `dari ${m.totalInvitations} undangan (perkiraan)`
      : `dari ${m.totalInvitations} undangan`,
  },
  {
    label: "Pendapatan bulan ini",
    value: formatRupiah(m.revenueThisMonth),
    sub: "Pesanan lunas",
  },
  {
    label: "Pendapatan total",
    value: formatRupiah(m.revenueAllTime),
    sub: "Sejak awal",
  },
  {
    label: "Menunggu verifikasi",
    value: m.awaitingVerification,
    sub: "Pesanan dengan bukti transfer",
    href: "/admin/pesanan?status=awaiting_verification",
    attention: m.awaitingVerification > 0,
  },
];
---

<AdminLayout title="Ringkasan" active="overview" adminName={actor.name}>
  {pending.length > 0 && (
    <section
      class:list={[
        "admin-card",
        "admin-readiness",
        { urgent: requiredPending.length > 0 },
      ]}
      aria-labelledby="readiness-title"
    >
      <h2 id="readiness-title">Persiapan sebelum berjualan</h2>
      <p class="admin-muted">
        {requiredPending.length > 0
          ? `${requiredPending.length} hal wajib belum siap. Pelanggan bisa kebingungan saat membayar sampai semuanya diisi.`
          : "Hal wajib sudah siap. Lengkapi yang disarankan agar layanan lebih mulus."}
      </p>
      <ul>
        {readiness.map((item) => (
          <li class:list={{ done: item.done }}>
            <span class="mark" aria-hidden="true">
              {item.done ? "✓" : item.level === "required" ? "!" : "·"}
            </span>
            <div>
              <strong>
                {item.href && !item.done ? (
                  <a class="admin-link" href={item.href}>
                    {item.label}
                  </a>
                ) : (
                  item.label
                )}
              </strong>
              <span class="admin-badge">
                {item.done
                  ? "Siap"
                  : item.level === "required"
                    ? "Wajib"
                    : "Disarankan"}
              </span>
              {!item.done && <p class="admin-muted">{item.hint}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section class="admin-kpis" aria-label="Indikator utama">
    {kpis.map((k) => {
      const Tag = k.href ? "a" : "div";
      return (
        <Tag
          class:list={["admin-card", "admin-kpi", { attention: k.attention }]}
          href={k.href}
        >
          <span class="label">{k.label}</span>
          <span class="value">{k.value}</span>
          <span class="sub">{k.sub}</span>
        </Tag>
      );
    })}
  </section>

  <section class="admin-card" style="margin-bottom:24px">
    <h2>Pendapatan 6 bulan terakhir</h2>
    <RevenueChart months={m.monthlyRevenue} />
  </section>

  <div class="admin-grid">
    <section class="admin-card">
      <h2>Pendaftar terbaru</h2>
      {m.latestSignups.length === 0 ? (
        <p class="admin-muted">Belum ada pelanggan.</p>
      ) : (
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Nama</th>
                <th scope="col">Daftar</th>
              </tr>
            </thead>
            <tbody>
              {m.latestSignups.map((u) => (
                <tr>
                  <td>
                    <a class="admin-link" href={`/admin/pelanggan/${u.id}`}>
                      {u.name}
                    </a>
                    <div class="admin-muted">{u.email}</div>
                  </td>
                  <td>{formatDate(u.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
    <section class="admin-card">
      <h2>Pesanan lunas terbaru</h2>
      {m.latestPaidOrders.length === 0 ? (
        <p class="admin-muted">Belum ada pesanan lunas.</p>
      ) : (
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Pesanan</th>
                <th scope="col" class="num">
                  Total
                </th>
              </tr>
            </thead>
            <tbody>
              {m.latestPaidOrders.map((o) => (
                <tr>
                  <td>
                    {o.number}
                    <div class="admin-muted">
                      {o.customerName}, {formatDate(o.paidAt || o.updatedAt)}
                    </div>
                  </td>
                  <td class="num">{formatRupiah(o.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</AdminLayout>

<style>
  .admin-readiness {
    margin-bottom: 24px;
    border-left: 4px solid #b9c3a6;
  }
  .admin-readiness.urgent {
    border-left-color: #c9a227;
    background: #fffbea;
  }
  .admin-readiness h2 {
    margin: 0 0 6px;
  }
  .admin-readiness ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .admin-readiness li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .admin-readiness li strong {
    font-size: 14px;
    margin-right: 8px;
  }
  .admin-readiness li p {
    margin: 4px 0 0;
    font-size: 12px;
  }
  .admin-readiness .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #f1dcc0;
    color: #7a4d14;
    font-size: 13px;
    font-weight: 700;
  }
  .admin-readiness li.done .mark {
    background: #dfe9d3;
    color: #3f5a24;
  }
  .admin-readiness li.done strong {
    color: var(--muted);
    font-weight: 500;
  }
</style>
