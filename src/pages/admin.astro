---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getActor } from "../server/auth";

const actor = await getActor(Astro.request);
if (!actor) return Astro.redirect("/login");
Astro.response.headers.set("Cache-Control", "private, no-store");
const allowed = actor.role === "admin";
if (!allowed) Astro.response.status = 403;
---

<BaseLayout title="Admin — Temu" noindex>
  <main class="admin-shell">
    <a href="/" class="admin-brand">
      temu.
    </a>
    {allowed ? (
      <section>
        <h1>Panel admin</h1>
        <p>Halaman ini disiapkan untuk pengelolaan pelanggan dan paket.</p>
        <a href="/dashboard">Ke dashboard</a>
      </section>
    ) : (
      <section>
        <h1>Akses ditolak</h1>
        <p>Halaman ini hanya untuk admin.</p>
        <a href="/dashboard">Kembali ke dashboard</a>
      </section>
    )}
  </main>
</BaseLayout>
<style>
  .admin-shell {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 40px 20px;
    background: var(--paper);
    text-align: center;
  }
  .admin-brand {
    font: 52px var(--serif);
    letter-spacing: -3px;
  }
  h1 {
    font: 36px/1.1 var(--serif);
    margin-bottom: 12px;
  }
  p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  a:not(.admin-brand) {
    font-size: 12px;
    color: var(--olive);
    text-decoration: underline;
  }
</style>
