---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InvitationEditor from "../../components/dashboard/InvitationEditor.astro";
import UpgradeHint from "../../components/dashboard/UpgradeHint.astro";
import Icon from "../../components/Icon.astro";
import { getActor } from "../../server/auth";
import { getDashboardData } from "../../server/services";
import { getBudget } from "../../server/budget";
import { getGuests } from "../../server/guests";
import { summarizeGuests } from "../../modules/invitations/domain/guests";
import { loadEntitlements } from "../../server/tenant";
import { UPGRADE_LABEL, UPGRADE_PATH } from "../../modules/billing/gating";
import {
  BUDGET_CATEGORIES,
  BUDGET_BEARERS,
  BEARER_LABELS,
  CATEGORY_LABELS,
} from "../../modules/invitations/domain/budget";
import "../../styles/dashboard.css";
const actor = await getActor(Astro.request);
if (!actor) return Astro.redirect("/login");
Astro.response.headers.set("Cache-Control", "private, no-store");
const selected = Astro.url.searchParams.get("undangan") || undefined;
const { invitation, invitations, stats, rsvps, wishes } =
  await getDashboardData(actor, selected);
const budget = await getBudget(actor);
const { features } = await loadEntitlements(actor.workspaceId);
const guestSummary = features.guestList
  ? (await getGuests(actor, invitation.slug)).summary
  : summarizeGuests([]);
const rupiah = (value: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);
const c = invitation.draft;
const eventDate = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Makassar",
}).format(new Date(c.date));
---

<BaseLayout title="Ruang Undangan — Temu" noindex>
  <div class="dashboard-shell">
    <aside class="sidebar">
      <a class="dash-brand" href="/">
        temu.
      </a>
      <span class="sidebar-label">RUANG PERSONAL</span>
      <nav aria-label="Dashboard">
        <a class="active" href="#overview">
          <Icon name="grid" size={19} /> Ringkasan
        </a>
        <a href="#editor">
          <Icon name="edit" size={19} /> Edit undangan
        </a>
        <a href="#responses">
          <Icon name="users" size={19} /> Kehadiran{" "}
          <span>{stats.responses}</span>
        </a>
        <a href={features.guestList ? "#guests" : "#guests-locked"}>
          <Icon name="mail" size={19} /> Daftar tamu{" "}
          <span data-guest-nav-count>{guestSummary.total}</span>
        </a>
        <a href={`/dashboard/checkin?undangan=${invitation.slug}`}>
          <Icon name="check" size={19} /> Check-in{" "}
          <span>{guestSummary.checkedIn}</span>
        </a>
        <a href="#wishes">
          <Icon name="heart" size={19} /> Ucapan{" "}
          <span>{stats.pendingWishes}</span>
        </a>
        <a href="#budget">
          <Icon name="shield" size={19} /> Anggaran{" "}
          <span>{budget.summary.items}</span>
        </a>
        <a href="/dashboard/akun">
          <Icon name="user" size={19} /> Akun
        </a>
      </nav>
      <div class="sidebar-note">
        <Icon name="spark" size={24} />
        <p>
          Detail kecil.
          <br />
          Kenangan selamanya.
        </p>
        <a href={`/i/${invitation.slug}?preview=1`} target="_blank">
          Lihat undangan <Icon name="arrow" size={15} />
        </a>
      </div>
      <button id="logout" class="logout">
        <Icon name="logout" size={17} /> Keluar
      </button>
    </aside>
    <main class="dashboard-main">
      <header class="dashboard-topbar">
        <span>
          Ruang undangan <span>/</span> Ringkasan
        </span>
        <div>
          <span class="workspace-dot"></span> Workspace personal{" "}
          <span class="avatar">
            {c.groom[0]}
            {c.bride[0]}
          </span>
        </div>
      </header>
      <div class="dashboard-content">
        <section id="overview">
          <div class="welcome">
            <div>
              <span class="dash-kicker">SEBUAH CERITA, SEBUAH PERAYAAN</span>
              <h1>
                Halo, {c.groom} & {c.bride}.
              </h1>
              <p>Semua persiapan hari bahagia kalian, dalam satu ruang.</p>
            </div>
            <a
              class="dash-button secondary"
              href={`/i/${invitation.slug}?preview=1`}
              target="_blank"
            >
              <Icon name="eye" size={17} /> Pratinjau
            </a>
          </div>
          <section class="invitation-switcher" aria-label="Pilih undangan">
            <div class="invitation-switcher-list">
              {invitations.map((item) => (
                <a
                  href={`/dashboard?undangan=${item.slug}`}
                  class:list={[
                    "invitation-chip",
                    item.slug === invitation.slug && "is-active",
                  ]}
                  aria-current={
                    item.slug === invitation.slug ? "true" : undefined
                  }
                >
                  <strong>{item.ceremonyTitle || item.title}</strong>
                  <span>/i/{item.slug}</span>
                  <em>{item.status === "published" ? "Terbit" : "Draft"}</em>
                </a>
              ))}
            </div>
            <form class="invitation-create" id="create-invitation">
              <label>
                Undangan baru
                <input
                  name="slug"
                  required
                  minlength="3"
                  maxlength="80"
                  pattern="[a-z0-9]+(-[a-z0-9]+)*"
                  placeholder="resepsi-sesi-2"
                />
              </label>
              <button type="submit">Buat salinan</button>
              <p class="invitation-create-note">
                Isi undangan yang sedang dibuka disalin sebagai titik awal.
              </p>
              <p id="create-invitation-error" role="alert"></p>
            </form>
          </section>
          <div class="invitation-overview">
            <div class="overview-art">
              <span>THE WEDDING OF</span>
              <h2>
                {c.groom}
                <i>&</i>
                {c.bride}
              </h2>
              <span>{eventDate.toUpperCase()}</span>
              <div class="overview-leaf" aria-hidden="true">
                <Icon name="spark" size={80} />
              </div>
            </div>
            <div class="overview-details">
              <div class="overview-title">
                <span class="dash-kicker">UNDANGAN KALIAN</span>
                <span
                  class:list={[
                    "status-pill",
                    invitation.status === "published" ? "published" : "draft",
                  ]}
                >
                  {invitation.status === "published" ? "Sudah terbit" : "Draft"}
                </span>
              </div>
              <h2>
                {c.groom} & {c.bride}
              </h2>
              <p>
                <Icon name="calendar" size={15} /> {eventDate} <span>·</span>{" "}
                {c.venue}
              </p>
              <div class="invitation-url">
                <Icon name="link" size={16} />
                <span>/i/{invitation.slug}</span>
                <button id="copy-link" aria-label="Salin tautan undangan">
                  Salin tautan
                </button>
              </div>
              <details class="slug-settings">
                <summary>Personalisasi tautan undangan</summary>
                {!features.customSlug && <UpgradeHint />}
                <form
                  id="slug-form"
                  class="slug-form"
                  inert={!features.customSlug}
                >
                  <label for="new-slug">Nama tautan</label>
                  <div>
                    <span>/i/</span>
                    <input
                      id="new-slug"
                      name="newSlug"
                      value={invitation.slug}
                      pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                      minlength="3"
                      maxlength="80"
                      required
                      autocomplete="off"
                    />
                    <button type="submit" class="dash-button secondary">
                      Simpan tautan
                    </button>
                  </div>
                  <p>
                    Gunakan huruf kecil, angka, dan tanda hubung. Tautan lama
                    tetap mengarah ke undangan ini.
                  </p>
                </form>
              </details>
              <div class="overview-actions">
                <a href="#editor" class="dash-button">
                  <Icon name="edit" size={16} /> Edit undangan
                </a>
                <button
                  class="dash-button secondary"
                  id="publish"
                  data-slug={invitation.slug}
                >
                  Terbitkan draft <Icon name="arrow" size={16} />
                </button>
                {invitation.status === "published" && (
                  <button
                    class="subtle-button"
                    id="unpublish"
                    data-slug={invitation.slug}
                  >
                    Tarik dari publik
                  </button>
                )}
              </div>
            </div>
          </div>
          <div class="stats-grid">
            {[
              {
                label: "Total respons",
                value: stats.responses,
                icon: "mail",
                note: "Konfirmasi yang diterima",
              },
              {
                label: "Bersedia hadir",
                value: stats.attending,
                icon: "check",
                note: `${stats.guests} orang akan merayakan`,
              },
              {
                label: "Tidak hadir",
                value: stats.declined,
                icon: "calendar",
                note: "Tetap mengirim doa terbaik",
              },
              {
                label: "Ucapan menunggu",
                value: stats.pendingWishes,
                icon: "heart",
                note: "Siap untuk ditinjau",
              },
            ].map((s) => (
              <article>
                <span>
                  {s.label}
                  <Icon name={s.icon} size={18} />
                </span>
                <strong>{s.value}</strong>
                <small>{s.note}</small>
              </article>
            ))}
          </div>
        </section>
        <section id="editor" class="dashboard-section">
          <div class="dash-section-heading">
            <div>
              <span class="dash-kicker">JADIKAN MILIK KALIAN</span>
              <h2>Detail undangan</h2>
            </div>
            <span class="draft-note">Perubahan tersimpan sebagai draft</span>
          </div>
          <InvitationEditor invitation={invitation} features={features} />
        </section>
        <section id="responses" class="dashboard-section">
          <div class="dash-section-heading">
            <div>
              <span class="dash-kicker">ORANG-ORANG TERSAYANG</span>
              <h2>Konfirmasi kehadiran</h2>
            </div>
            <div class="dash-heading-actions">
              <span class="count-label">{stats.responses} respons</span>
              <a
                class="dash-button secondary"
                href={`/api/invitations/${invitation.slug}/rsvp.csv`}
                download
              >
                Ekspor RSVP (CSV)
              </a>
            </div>
          </div>
          <div class="table-wrap">
            {rsvps.length ? (
              <table>
                <thead>
                  <tr>
                    <th>Nama tamu</th>
                    <th>Kehadiran</th>
                    <th>Jumlah</th>
                    <th>Diperbarui</th>
                  </tr>
                </thead>
                <tbody>
                  {rsvps.map((r) => (
                    <tr>
                      <td>{r.name}</td>
                      <td>
                        <span
                          class:list={[
                            "status-pill",
                            r.attendance === "attending"
                              ? "published"
                              : "draft",
                          ]}
                        >
                          {r.attendance === "attending"
                            ? "Hadir"
                            : "Tidak hadir"}
                        </span>
                      </td>
                      <td>{r.attendeeCount} orang</td>
                      <td>
                        {new Date(r.updatedAt).toLocaleDateString("id-ID", {
                          timeZone: "Asia/Makassar",
                        })}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div class="empty-state">
                <Icon name="users" size={32} />
                <h3>Daftar bahagia akan segera terisi.</h3>
                <p>
                  Bagikan tautan undangan. Konfirmasi tamu akan muncul di sini.
                </p>
              </div>
            )}
          </div>
        </section>
        <section id="wishes" class="dashboard-section">
          <div class="dash-section-heading">
            <div>
              <span class="dash-kicker">KATA-KATA YANG MENGHANGATKAN</span>
              <h2>Ucapan & doa</h2>
            </div>
            <div class="dash-heading-actions">
              <span class="count-label">{wishes.length} ucapan</span>
              <a
                class="dash-button secondary"
                href={`/api/invitations/${invitation.slug}/ucapan.csv`}
                download
              >
                Ekspor ucapan (CSV)
              </a>
            </div>
          </div>
          <div class="wishes-list">
            {wishes.length ? (
              wishes.map((w) => (
                <article class="wish-row">
                  <span class="wish-avatar">{w.name.slice(0, 1)}</span>
                  <div>
                    <h3>
                      {w.name}
                      <span>
                        {w.status === "approved"
                          ? "Ditampilkan"
                          : w.status === "hidden"
                            ? "Disembunyikan"
                            : "Menunggu tinjauan"}
                      </span>
                    </h3>
                    <p>{w.message}</p>
                    {w.reply && (
                      <p class="wish-reply">
                        <strong>Balasan Anda:</strong> {w.reply}
                      </p>
                    )}
                    <form class="wish-reply-form" data-id={w.id}>
                      <label>
                        <span class="sr-only">Balasan untuk {w.name}</span>
                        <textarea
                          name="reply"
                          maxlength="500"
                          rows="2"
                          placeholder="Tulis balasan singkat (maks. 500 karakter)"
                        >{w.reply ?? ""}</textarea>
                      </label>
                      <button class="moderate" type="submit">
                        {w.reply ? "Ubah balasan" : "Kirim balasan"}
                      </button>
                      {w.reply && (
                        <button
                          class="moderate secondary"
                          type="button"
                          data-clear-reply
                        >
                          Hapus balasan
                        </button>
                      )}
                    </form>
                  </div>
                  <div class="wish-actions">
                    {w.status !== "approved" && (
                      <button
                        class="moderate"
                        data-id={w.id}
                        data-status="approved"
                      >
                        Tampilkan
                      </button>
                    )}
                    {w.status !== "hidden" && (
                      <button
                        class="moderate secondary"
                        data-id={w.id}
                        data-status="hidden"
                      >
                        Sembunyikan
                      </button>
                    )}
                    <button
                      class="moderate danger"
                      type="button"
                      data-delete-wish={w.id}
                      data-name={w.name}
                    >
                      Hapus
                    </button>
                  </div>
                </article>
              ))
            ) : (
              <div class="empty-state">
                <Icon name="heart" size={30} />
                <h3>Ruang untuk doa baik.</h3>
                <p>
                  Ucapan baru tampil di undangan setelah Anda menyetujuinya.
                </p>
              </div>
            )}
          </div>
        </section>
        {features.guestList ? (
          <section
            id="guests"
            class="dashboard-section"
            data-slug={invitation.slug}
          >
            <div class="dash-section-heading">
              <div>
                <span class="dash-kicker">UNDANGAN PERSONAL</span>
                <h2>Daftar tamu</h2>
              </div>
              <span class="count-label" id="guest-count">
                {guestSummary.total} tamu
              </span>
            </div>
            <p class="budget-intro">
              Daftar ini khusus untuk undangan /i/{invitation.slug}. Tiap tamu
              mendapat tautan pribadi dan kode QR masuk.
            </p>
            <div class="budget-stats guest-stats">
              {[
                ["total", "Total tamu", String(guestSummary.total)],
                [
                  "belumDikirim",
                  "Belum dikirim",
                  String(guestSummary.belumDikirim),
                ],
                ["terkirim", "Terkirim", String(guestSummary.terkirim)],
                ["dibuka", "Dibuka", String(guestSummary.dibuka)],
                [
                  "hadir",
                  "RSVP hadir",
                  `${guestSummary.hadir} · ${guestSummary.hadirOrang} orang`,
                ],
                ["tidakHadir", "Tidak hadir", String(guestSummary.tidakHadir)],
                [
                  "checkedIn",
                  "Sudah check-in",
                  `${guestSummary.checkedIn} · ${guestSummary.checkedInOrang} orang`,
                ],
              ].map(([key, label, value]) => (
                <article>
                  <span>{label}</span>
                  <strong data-stat={key}>{value}</strong>
                </article>
              ))}
            </div>

            <form class="budget-form" id="guest-form">
              <h3 id="guest-form-title">Tambah tamu</h3>
              <div class="form-grid">
                <label>
                  Nama tamu
                  <input
                    name="name"
                    required
                    maxlength="100"
                    placeholder="Bapak I Made Wirawan"
                  />
                </label>
                <label>
                  Nomor WhatsApp
                  <input
                    name="phone"
                    maxlength="40"
                    inputmode="tel"
                    placeholder="0812 3456 7890 (opsional)"
                  />
                </label>
                <label>
                  Grup / kategori
                  <input
                    name="group"
                    maxlength="60"
                    list="guest-groups"
                    placeholder="Keluarga, Kolega… (opsional)"
                  />
                  <datalist id="guest-groups"></datalist>
                </label>
                <label>
                  Jatah orang
                  <input
                    type="number"
                    name="maxPax"
                    min="1"
                    max="5"
                    placeholder="Opsional"
                  />
                </label>
              </div>
              <div class="guest-form-actions">
                <button type="submit" class="dash-button" id="guest-submit">
                  Tambah tamu
                </button>
                <button
                  type="button"
                  class="dash-button secondary"
                  id="guest-cancel"
                  hidden
                >
                  Batal
                </button>
              </div>
              <p id="guest-error" role="alert"></p>
            </form>

            <details class="guest-details">
              <summary>Impor banyak tamu</summary>
              <p class="budget-intro">
                Satu tamu per baris: nama, nomor, grup (dipisah koma, titik
                koma, atau tab). Baris dengan nama dan nomor yang sudah ada
                dilewati.
              </p>
              <textarea
                id="guest-import-text"
                rows="6"
                placeholder={
                  "Bapak Made Wirawan, 081234567890, Keluarga\nIbu Sari, 0812-9999-0000, Kolega"
                }
              ></textarea>
              <div class="guest-form-actions">
                <button
                  type="button"
                  class="dash-button"
                  id="guest-import-submit"
                >
                  Impor daftar
                </button>
                <label class="dash-button secondary budget-import-label">
                  Pilih berkas CSV
                  <input
                    type="file"
                    id="guest-import-file"
                    accept=".csv,.txt,text/csv,text/plain"
                    hidden
                  />
                </label>
              </div>
              <pre id="guest-import-result" class="guest-import-result"></pre>
            </details>

            <details class="guest-details">
              <summary>Pesan WhatsApp</summary>
              <p class="budget-intro">
                Gunakan <code>{"{nama}"}</code> untuk nama tamu dan{" "}
                <code>{"{tautan}"}</code> untuk tautan pribadinya.
              </p>
              <textarea
                id="guest-template"
                rows="9"
                maxlength="1000"
              ></textarea>
              <div class="guest-form-actions">
                <button
                  type="button"
                  class="dash-button"
                  id="guest-template-save"
                >
                  Simpan pesan
                </button>
                <button
                  type="button"
                  class="dash-button secondary"
                  id="guest-template-reset"
                >
                  Pakai pesan bawaan
                </button>
              </div>
            </details>

            <div class="guest-toolbar">
              <input
                type="search"
                id="guest-search"
                placeholder="Cari nama, nomor, atau grup"
                aria-label="Cari tamu"
              />
              <select id="guest-status-filter" aria-label="Saring status">
                <option value="">Semua status</option>
                <option value="belum-dikirim">Belum dikirim</option>
                <option value="terkirim">Terkirim</option>
                <option value="dibuka">Dibuka</option>
                <option value="hadir">RSVP hadir</option>
                <option value="tidak-hadir">Tidak hadir</option>
                <option value="belum-checkin">Hadir, belum check-in</option>
                <option value="checkin">Sudah check-in</option>
              </select>
              <select id="guest-group-filter" aria-label="Saring grup">
                <option value="">Semua grup</option>
              </select>
              <a
                class="dash-button secondary"
                href={`/api/guests/export.csv?slug=${encodeURIComponent(invitation.slug)}`}
                download
              >
                Ekspor CSV
              </a>
              <a
                class="dash-button secondary"
                href={`/dashboard/checkin?undangan=${invitation.slug}`}
              >
                Buka check-in
              </a>
            </div>
            <div id="guest-list" class="guest-list"></div>
          </section>
        ) : (
          <section id="guests-locked" class="dashboard-section">
            <div class="dash-section-heading">
              <div>
                <span class="dash-kicker">UNDANGAN PERSONAL</span>
                <h2>Daftar tamu</h2>
              </div>
            </div>
            <p class="plan-lock" role="note">
              Daftar tamu, tautan personal, dan check-in QR belum termasuk dalam
              paket Anda. {UPGRADE_LABEL} ·{" "}
              <a href={UPGRADE_PATH}>Lihat paket</a>
            </p>
          </section>
        )}
        <section id="budget" class="dashboard-section">
          <div class="dash-section-heading">
            <div>
              <span class="dash-kicker">RENCANA & REALISASI</span>
              <h2>Anggaran pernikahan</h2>
            </div>
            <span class="count-label">{budget.summary.items} pos</span>
          </div>
          <p class="budget-intro">
            Anggaran berlaku untuk satu pernikahan, dipakai bersama oleh semua
            undangan di ruang ini.
          </p>

          <form class="budget-cap" id="budget-cap-form">
            <label>
              Pagu total (Rp)
              <input
                type="number"
                name="cap"
                min="0"
                step="1000"
                value={budget.settings.cap || ""}
                placeholder="0"
              />
            </label>
            <button type="submit" class="dash-button secondary">
              Simpan pagu
            </button>
            <button
              type="button"
              class="dash-button secondary"
              id="budget-template"
            >
              Isi kerangka pawiwahan
            </button>
            <a
              class="dash-button secondary"
              href="/api/budget/export.csv"
              download
            >
              Ekspor CSV
            </a>
            <label class="dash-button secondary budget-import-label">
              Impor CSV
              <input
                type="file"
                id="budget-import"
                accept=".csv,text/csv"
                hidden
              />
            </label>
          </form>
          <div id="budget-due" class="budget-due" hidden></div>
          <div id="budget-bearers" class="budget-bearers"></div>

          <div class="budget-stats" id="budget-stats">
            <article>
              <span>Estimasi</span>
              <strong>{rupiah(budget.summary.estimate)}</strong>
            </article>
            <article>
              <span>Komitmen</span>
              <strong>{rupiah(budget.summary.committed)}</strong>
            </article>
            <article>
              <span>Sudah dibayar</span>
              <strong>{rupiah(budget.summary.paid)}</strong>
            </article>
            <article class={budget.summary.outstanding ? "is-warning" : ""}>
              <span>Sisa tagihan</span>
              <strong>{rupiah(budget.summary.outstanding)}</strong>
            </article>
            <article class={budget.summary.overCap ? "is-danger" : ""}>
              <span>{budget.summary.overCap ? "Lewat pagu" : "Sisa pagu"}</span>
              <strong>
                {budget.settings.cap
                  ? rupiah(Math.abs(budget.summary.remainingCap))
                  : "Belum diatur"}
              </strong>
            </article>
          </div>

          <form class="budget-form" id="budget-form">
            <h3>Tambah pos anggaran</h3>
            <div class="form-grid">
              <label>
                Kategori
                <select name="category">
                  {BUDGET_CATEGORIES.map((category) => (
                    <option value={category}>
                      {CATEGORY_LABELS[category]}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                Penanggung
                <select name="bearer">
                  {BUDGET_BEARERS.map((bearer) => (
                    <option value={bearer}>{BEARER_LABELS[bearer]}</option>
                  ))}
                </select>
              </label>
              <label>
                Nama pos
                <input
                  name="name"
                  required
                  maxlength="120"
                  placeholder="Banten pawiwahan"
                />
              </label>
              <label>
                Vendor / pelaksana
                <input name="vendor" maxlength="120" placeholder="Opsional" />
              </label>
              <label>
                Estimasi (Rp)
                <input
                  type="number"
                  name="estimate"
                  min="0"
                  step="1000"
                  value="0"
                />
              </label>
              <label>
                Realisasi (Rp)
                <input
                  type="number"
                  name="actual"
                  min="0"
                  step="1000"
                  value="0"
                />
              </label>
              <label>
                Sudah dibayar (Rp)
                <input
                  type="number"
                  name="paid"
                  min="0"
                  step="1000"
                  value="0"
                />
              </label>
              <label>
                Jatuh tempo
                <input type="date" name="dueDate" />
              </label>
              <label>
                Catatan
                <input name="note" maxlength="500" placeholder="Opsional" />
              </label>
            </div>
            <button type="submit" class="dash-button">
              Tambah pos
            </button>
            <p id="budget-error" role="alert"></p>
          </form>

          <div id="budget-charts" class="budget-charts"></div>
          <div id="budget-list" class="budget-list"></div>
        </section>
        <footer class="dashboard-footer">
          <span>temu.</span> Dibuat untuk cerita yang berarti.
        </footer>
      </div>
    </main>
  </div>
  <div class="toast" id="toast" role="status" hidden></div>
</BaseLayout>
<script>
  import "../../components/dashboard/editor";
  import "../../components/dashboard/budget";
  import "../../components/dashboard/guests";
</script>
