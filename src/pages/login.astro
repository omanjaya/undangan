---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PasswordField from "../components/auth/PasswordField.astro";
import { safeNextPath } from "../modules/accounts/next-path";
import { getActor } from "../server/auth";
import "../styles/auth.css";
Astro.response.headers.set("Cache-Control", "private, no-store");
// Hanya jalur relatif satu origin yang dipakai; selain itu kembali ke dashboard.
const next = safeNextPath(Astro.url.searchParams.get("next"));
if (await getActor(Astro.request)) return Astro.redirect("/dashboard");
const demo =
  process.env.NODE_ENV !== "production" && !process.env.OWNER_PASSWORD;
const justReset = Astro.url.searchParams.get("reset") === "1";
---

<BaseLayout title="Masuk — Temu" noindex>
  <main class="login-shell">
    <a href="/" class="login-brand">
      temu.
    </a>
    <section class="login-card">
      <span class="kicker">RUANG UNTUK CERITA KALIAN</span>
      <h1>
        Selamat datang
        <br />
        <em>kembali.</em>
      </h1>
      <p>Masuk untuk merangkai dan membagikan hari istimewa kalian.</p>
      {justReset && (
        <p class="notice" role="status" id="login-notice">
          Kata sandi berhasil diubah. Silakan masuk dengan kata sandi baru.
        </p>
      )}
      <form id="login-form" data-next={next}>
        <div class="field">
          <label>
            Email
            <input
              required
              type="email"
              name="email"
              autocomplete="username"
              value={demo ? "owner@undangan.local" : ""}
            />
          </label>
        </div>
        <PasswordField
          label="Kata sandi"
          name="password"
          autocomplete="current-password"
          value={demo ? "demo-undangan-2026" : ""}
        />
        <a class="forgot" href="/lupa-sandi">
          Lupa kata sandi?
        </a>
        <p id="login-error" class="form-msg" role="alert"></p>
        <button type="submit">
          Masuk ke ruang undangan <Icon name="arrow" size={18} />
        </button>
      </form>
      {demo && (
        <aside>
          Mode demo lokal. Akun contoh sudah diisi agar Anda bisa menjelajahi
          editor.
        </aside>
      )}
      <p class="switch">
        Belum punya akun? <a href="/daftar">Daftar gratis</a>
      </p>
      <a class="back" href="/">
        Kembali ke beranda
      </a>
    </section>
    <span class="login-bottom">CERITA INDAH DIMULAI DARI SINI.</span>
  </main>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>("#login-form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("[type=submit]")!;
    const error = document.querySelector<HTMLElement>("#login-error")!;
    button.disabled = true;
    error.textContent = "";
    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...Object.fromEntries(new FormData(form)),
          next: form.dataset.next,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      // Server sudah menyaring `next`; hanya jalur relatif yang dikembalikan.
      window.location.href = data.next || "/dashboard";
    } catch (e) {
      error.textContent =
        e instanceof Error ? e.message : "Tidak dapat masuk. Coba lagi.";
      button.disabled = false;
    }
  });
</script>
