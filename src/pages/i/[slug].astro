---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialBotanical from "../../components/invitation/EditorialBotanical.astro";
import { getInvitation } from "../../server/services";
import { getGuestForPage } from "../../server/guests";
import { qrSvg } from "../../server/qr";
import { getActor } from "../../server/auth";
import { loadEntitlements } from "../../server/tenant";
import {
  gateContent,
  mayShowGuestQr,
  mayTrackGuests,
} from "../../modules/billing/gating";
export const prerender = false;
const preview = Astro.url.searchParams.get("preview") === "1";
const invitation = await getInvitation(Astro.params.slug ?? "");
let permitted = true;
if (preview) {
  const actor = await getActor(Astro.request);
  permitted =
    !!actor && !!invitation && actor.workspaceId === invitation.workspaceId;
}
const saved =
  invitation && permitted
    ? preview
      ? invitation.draft
      : invitation.status === "published"
        ? invitation.published
        : null
    : null;
// Hak paket pemilik menentukan fitur yang tampil (pratinjau pun sama). Isi
// tersimpan tidak diubah; hanya tampilannya yang disaring.
const features =
  saved && invitation
    ? (await loadEntitlements(invitation.workspaceId)).features
    : null;
const content = saved && features ? gateContent(saved, features) : null;
if (content && invitation && Astro.params.slug !== invitation.slug) {
  const canonical = new URL(Astro.url);
  canonical.pathname = `/i/${encodeURIComponent(invitation.slug)}`;
  return Astro.redirect(canonical.pathname + canonical.search, 308);
}
// Kode tamu hanya dikenali pada tampilan publik; pratinjau pemilik tidak
// menandai tamu mana pun sebagai sudah membuka.
const guest =
  content && invitation && !preview && features && mayTrackGuests(features)
    ? await getGuestForPage(invitation.slug, Astro.url.searchParams.get("g"))
    : null;
const checkinOrigin = process.env.APP_URL
  ? new URL(process.env.APP_URL).origin
  : Astro.url.origin;
const guestQr =
  guest &&
  features &&
  mayShowGuestQr(features) &&
  guest.attendance !== "declined"
    ? await qrSvg(
        `${checkinOrigin}/dashboard/checkin?undangan=${encodeURIComponent(invitation!.slug)}&kode=${guest.code}`,
      )
    : "";
if (!content) Astro.response.status = 404;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<BaseLayout
  title={
    content
      ? `${content.groom} & ${content.bride} — Undangan Pernikahan`
      : "Undangan tidak ditemukan"
  }
  description={content?.opening ?? "Undangan belum tersedia."}
  shareImage={
    !preview && content
      ? `/api/og/${encodeURIComponent(invitation!.slug)}.png`
      : undefined
  }
  noindex
>
  {content ? (
    <EditorialBotanical
      content={content}
      slug={invitation!.slug}
      preview={preview}
      guest={guest}
      guestQr={guestQr}
      branding={!features?.removeBranding}
    />
  ) : (
    <main style="min-height:80vh;display:grid;place-content:center;text-align:center;padding:32px">
      <p>TEMU</p>
      <h1>Undangan belum tersedia.</h1>
      <p>Tautan mungkin tidak berlaku atau undangan belum dipublikasikan.</p>
      <a href="/">Kembali ke beranda</a>
    </main>
  )}
</BaseLayout>
