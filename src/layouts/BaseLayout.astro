---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  shareImage?: string;
}
const {
  title = "Temu — Cerita indah, dimulai di sini.",
  description = "Undangan digital yang terasa personal. Dibuat untuk cerita Anda, dirancang untuk setiap layar.",
  noindex = false,
  shareImage,
} = Astro.props;
const configuredOrigin = process.env.APP_URL || Astro.site?.origin;
const canonicalUrl = configuredOrigin
  ? new URL(Astro.url.pathname, configuredOrigin).href
  : undefined;
import "../styles/global.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-600.css";
import "@fontsource/italiana/latin-400.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {shareImage && (
      <>
        <meta
          property="og:image"
          content={
            new URL(shareImage, configuredOrigin || Astro.url.origin).href
          }
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={title} />
        <meta
          name="twitter:image"
          content={
            new URL(shareImage, configuredOrigin || Astro.url.origin).href
          }
        />
      </>
    )}
    <meta
      name="twitter:card"
      content={shareImage ? "summary_large_image" : "summary"}
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
