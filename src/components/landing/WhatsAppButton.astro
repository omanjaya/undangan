---
import { getSiteConfig, whatsappLink } from "../../config/site";
const site = getSiteConfig();
const href = whatsappLink(
  site.whatsapp,
  `Halo ${site.name}, saya ingin bertanya tentang undangan digital.`,
);
---

<a
  class="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Hubungi kami lewat WhatsApp"
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 20l1.3-4.2A8 8 0 1 1 8.3 18.8Z"></path>
    <path d="M9 8.5c0 3 2.5 5.5 5.5 5.5l1-1.3-1.8-1-.8.7a3.6 3.6 0 0 1-1.8-1.8l.7-.8-1-1.8Z"></path>
  </svg>
  <span>Tanya via WhatsApp</span>
</a>
