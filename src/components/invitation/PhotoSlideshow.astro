---
interface Props {
  photos: string[];
  theme: string;
}
const { photos = [], theme } = Astro.props;
const uniquePhotos = [...new Set(photos.filter(Boolean))].slice(0, 12);
const artwork = uniquePhotos.length === 0;
const themeArtwork: Record<
  string,
  { src: string; title: string; note: string }[]
> = {
  "jepun-ivory": [
    {
      src: "/ornaments/theme-pack/ivory-floral-crescent.webp",
      title: "Mekar dalam kasih",
      note: "Jepun Ivory · rangkaian floral",
    },
    {
      src: "/ornaments/theme-pack/ivory-jepun-cascade.webp",
      title: "Terangkai dengan lembut",
      note: "Jepun Ivory · bunga dan doa",
    },
    {
      src: "/ornaments/jepun-corner.webp",
      title: "Sebuah janji yang tumbuh",
      note: "Jepun Ivory · selamanya bersama",
    },
  ],
  "puri-emerald": [
    {
      src: "/ornaments/candi-bentar.webp",
      title: "Gerbang sebuah perjalanan",
      note: "Puri Emerald · sambutan perayaan",
    },
    {
      src: "/ornaments/theme-pack/emerald-gold-fan.webp",
      title: "Dalam restu dan doa",
      note: "Puri Emerald · detail keemasan",
    },
    {
      src: "/ornaments/theme-pack/emerald-foliage-corner.webp",
      title: "Bersama dalam harmoni",
      note: "Puri Emerald · dedaunan zamrud",
    },
  ],
  "senja-terracotta": [
    {
      src: "/ornaments/theme-pack/terracotta-floral-spray.webp",
      title: "Sehangat sebuah pertemuan",
      note: "Senja Terracotta · bunga tropis",
    },
    {
      src: "/ornaments/theme-pack/terracotta-meadow-border.webp",
      title: "Tumbuh bersama",
      note: "Senja Terracotta · taman yang hangat",
    },
    {
      src: "/ornaments/bali-garden.webp",
      title: "Cerita yang berlanjut",
      note: "Senja Terracotta · hari yang dinanti",
    },
  ],
  "lotus-rosa": [
    {
      src: "/ornaments/theme-pack/rosa-corner.webp",
      title: "Mekar dalam kasih",
      note: "Lotus Rosa · rangkaian floral",
    },
    {
      src: "/ornaments/theme-pack/rosa-accent.webp",
      title: "Terangkai dengan lembut",
      note: "Lotus Rosa · bunga dan doa",
    },
    {
      src: "/ornaments/theme-pack/rosa-extra.webp",
      title: "Sebuah janji yang tumbuh",
      note: "Lotus Rosa · selamanya bersama",
    },
  ],
  "samudra-biru": [
    {
      src: "/ornaments/theme-pack/biru-extra.webp",
      title: "Gerbang sebuah perjalanan",
      note: "Samudra Biru · sambutan perayaan",
    },
    {
      src: "/ornaments/theme-pack/biru-accent.webp",
      title: "Dalam restu dan doa",
      note: "Samudra Biru · detail perak laut",
    },
    {
      src: "/ornaments/theme-pack/biru-corner.webp",
      title: "Bersama dalam harmoni",
      note: "Samudra Biru · dedaunan samudra",
    },
  ],
  "sawah-hijau": [
    {
      src: "/ornaments/theme-pack/hijau-corner.webp",
      title: "Tumbuh bersama",
