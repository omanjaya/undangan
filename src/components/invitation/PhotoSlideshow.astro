      src: "/ornaments/theme-pack/pasir-extra.webp",
      title: "Sebuah janji yang tumbuh",
      note: "Pasir Putih · selamanya bersama",
    },
  ],
  "elegansi-monokrom": [
    {
      src: "/ornaments/theme-pack/monokrom-extra.webp",
      title: "Gerbang sebuah perjalanan",
      note: "Elegansi Monokrom · sambutan perayaan",
    },
    {
      src: "/ornaments/theme-pack/monokrom-accent.webp",
      title: "Dalam restu dan doa",
      note: "Elegansi Monokrom · detail perak",
    },
    {
      src: "/ornaments/theme-pack/monokrom-corner.webp",
      title: "Bersama dalam harmoni",
      note: "Elegansi Monokrom · dedaunan monokrom",
    },
  ],
};
const slides = artwork
  ? themeArtwork[theme] || themeArtwork["jepun-ivory"]
  : uniquePhotos.map((src, index) => ({
      src,
      title: `Momen ${index + 1}`,
      note: "",
    }));
---

<photo-slideshow
  class="photo-slideshow"
  data-theme={theme}
  data-artwork={String(artwork)}
>
  <section
    class="slideshow-region"
    role="region"
    aria-roledescription="karusel"
    aria-label={artwork ? "Rangkaian keindahan Bali" : "Slideshow kenangan"}
    tabindex="0"
  >
    <div class="slideshow-stage">
      {slides.map((slide, index) => (
        <div
          class:list={["slideshow-slide", { "is-current": index === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} dari ${slides.length}`}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <img
            src={slide.src}
            alt={artwork ? "" : `Foto kenangan ${index + 1}`}
            loading="lazy"
            decoding="async"
            width="1200"
            height="900"
          />
          {artwork && (
            <div class="slideshow-caption">
              <span>{slide.note}</span>
              <h3>{slide.title}</h3>
            </div>
          )}
        </div>
      ))}
      <span class="slideshow-frame" aria-hidden="true"></span>
    </div>
    <div class="slideshow-toolbar" hidden={slides.length < 2}>
      <span class="slideshow-counter" aria-hidden="true">
        <span data-slide-number>01</span>
        <span class="slideshow-counter-line"></span>
        {String(slides.length).padStart(2, "0")}
      </span>
      <div class="slideshow-controls" hidden>
        <button type="button" data-slide-previous aria-label="Slide sebelumnya">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="m14 6-6 6 6 6M8 12h12" />
          </svg>
        </button>
        <button
          type="button"
          data-slide-toggle
          aria-label="Jeda slideshow"
          aria-pressed="false"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path data-pause-icon d="M9 6v12M15 6v12" />
            <path data-play-icon d="m9 5 10 7-10 7Z" data-hidden="true" />
          </svg>
        </button>
        <button type="button" data-slide-next aria-label="Slide berikutnya">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="m10 6 6 6-6 6M4 12h12" />
          </svg>
        </button>
      </div>
    </div>
    <p
      class="slideshow-sr"
      data-slide-status
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </section>
</photo-slideshow>

<style>
  .photo-slideshow {
    display: block;
    width: min(100%, 1056px);
    margin: 0 auto;
  }
  .slideshow-region {
    position: relative;
    touch-action: pan-y;
  }
  .slideshow-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--iv-line, #dbd9cc);
    border-radius: 160px 160px 3px 3px;
    isolation: isolate;
  }
  .slideshow-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease,
      visibility 1.2s;
  }
  .slideshow-slide::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 25%,
      #fff5 45%,
      transparent 65%
    );
    background-size: 220% 100%;
    animation: slideshow-loading 1.5s linear infinite;
  }
  .slideshow-slide.is-loaded::before,
  .slideshow-slide.is-error::before {
    display: none;
  }
  .slideshow-slide.is-error::after {
    content: "Foto belum dapat dimuat";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .slideshow-slide.is-current {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }
  .slideshow-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 7s linear;
  }
  .photo-slideshow[data-playing="true"] .slideshow-slide.is-current img {
    transform: scale(1.035);
  }
  .slideshow-frame {
    position: absolute;
    inset: 14px;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 148px 148px 2px 2px;
    pointer-events: none;
  }
  .slideshow-caption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 9%;
    text-align: center;
  }
  .slideshow-caption span {
    display: block;
    font-size: 10px;
    letter-spacing: 0.15em;
    margin-bottom: 9px;
  }
  .slideshow-caption h3 {
    font-size: clamp(25px, 3vw, 40px);
    line-height: 1.25;
  }
  [data-artwork="true"] .slideshow-stage {
    background: radial-gradient(ellipse at 50% 30%, #fffdf8 0%, #eee8db 100%);
    color: #394133;
  }
  [data-artwork="true"] .slideshow-slide img {
    position: absolute;
    width: 75%;
    height: 62%;
    top: 5%;
    left: 12.5%;
    object-fit: contain;
  }
  [data-artwork="true"] .slideshow-slide:nth-child(2) img {
    width: 83%;
    left: 8.5%;
    height: 58%;
    top: 9%;
  }
  [data-theme="puri-emerald"] .slideshow-stage {
    border-radius: 4px;
  }
  [data-theme="puri-emerald"] .slideshow-frame {
    border-radius: 0;
    border-color: #b8a175;
  }
  [data-theme="puri-emerald"][data-artwork="true"] .slideshow-stage {
    background: radial-gradient(ellipse at 50% 35%, #eceadb, #d6d6ba);
  }
  [data-theme="senja-terracotta"] .slideshow-stage {
    border-radius: 220px 220px 6px 6px;
  }
  [data-theme="senja-terracotta"] .slideshow-frame {
    border-radius: 208px 208px 3px 3px;
  }
  [data-theme="senja-terracotta"][data-artwork="true"] .slideshow-stage {
    background: radial-gradient(ellipse at 50% 30%, #fff6e9, #eed8c9);
    color: #754939;
  }
  .slideshow-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 2px 0;
  }
  .slideshow-counter {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }
  .slideshow-counter-line {
    display: block;
    width: 42px;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }
  .slideshow-controls {
    display: flex;
    gap: 8px;
  }
  .slideshow-controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--iv-line, #dbd9cc);
    border-radius: 50%;
    color: inherit;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s;
  }
  .slideshow-controls button:hover {
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  .slideshow-controls path[data-hidden="true"] {
    display: none;
  }
  .slideshow-controls svg {
    width: 20px;
    height: 20px;
  }
  .slideshow-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .slideshow-stage {
      aspect-ratio: 4 / 5;
      border-radius: 120px 120px 3px 3px;
    }
    .slideshow-frame {
      border-radius: 108px 108px 2px 2px;
      inset: 12px;
    }
    .slideshow-caption span {
      font-size: 9px;
      letter-spacing: 0.07em;
    }
    .slideshow-caption {
      left: 18px;
      right: 18px;
      bottom: 12%;
    }
    [data-artwork="true"] .slideshow-slide img {
      width: 88%;
      left: 6%;
      top: 8%;
      height: 57%;
    }
    [data-artwork="true"] .slideshow-slide:nth-child(2) img {
      top: 13%;
      height: 46%;
      width: 94%;
      left: 3%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slideshow-slide,
    .slideshow-slide img {
      transition: none;
    }
    .photo-slideshow[data-playing="true"] .slideshow-slide.is-current img {
      transform: none;
    }
  }
  @keyframes slideshow-loading {
    to {
      background-position: -220% 0;
    }
  }
</style>

<script>
  class PhotoSlideshow extends HTMLElement {
    disconnectedCallback() {
      this.cleanup?.();
    }
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const slides = Array.from(
        this.querySelectorAll<HTMLElement>(".slideshow-slide"),
      );
      const controller = new AbortController();
      const { signal } = controller;
      slides.forEach((slide) => {
        const image = slide.querySelector<HTMLImageElement>("img");
        if (!image) return;
        const loaded = () => slide.classList.add("is-loaded");
        const failed = () => slide.classList.add("is-error");
        if (image.complete) image.naturalWidth ? loaded() : failed();
        else image.addEventListener("load", loaded, { signal, once: true });
        image.addEventListener("error", failed, { signal, once: true });
      });
      if (slides.length < 2) {
        this.cleanup = () => {
          controller.abort();
          this.cleanup = undefined;
        };
        return;
      }
      const region = this.querySelector<HTMLElement>(".slideshow-region")!;
      const toggle = this.querySelector<HTMLButtonElement>(
        "[data-slide-toggle]",
      )!;
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      let index = 0;
      let paused = motion.matches;
      let visible = false;
      let focused = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      const stop = () => {
        clearTimeout(timer);
        timer = undefined;
        this.dataset.playing = "false";
      };
      const sync = () => {
        stop();
        toggle.setAttribute(
          "aria-label",
          paused ? "Putar slideshow" : "Jeda slideshow",
        );
        toggle.setAttribute("aria-pressed", String(paused));
        this.querySelector("[data-pause-icon]")?.setAttribute(
          "data-hidden",
          String(paused),
        );
        this.querySelector("[data-play-icon]")?.setAttribute(
          "data-hidden",
          String(!paused),
        );
        if (
          paused ||
          !visible ||
          focused ||
          document.hidden ||
          this.closest("[inert]")
        )
          return;
        this.dataset.playing = "true";
        timer = setTimeout(() => show(index + 1, false), 6000);
      };
      const show = (next: number, manual: boolean) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle("is-current", i === index);
          slide.setAttribute("aria-hidden", String(i !== index));
        });
        this.querySelector("[data-slide-number]")!.textContent = String(
          index + 1,
        ).padStart(2, "0");
        if (manual) {
          paused = true;
          this.querySelector("[data-slide-status]")!.textContent =
            `Slide ${index + 1} dari ${slides.length}`;
        }
        sync();
      };
      this.querySelector<HTMLElement>(".slideshow-controls")!.hidden = false;
      this.querySelector("[data-slide-previous]")!.addEventListener(
        "click",
        () => show(index - 1, true),
        { signal },
      );
      this.querySelector("[data-slide-next]")!.addEventListener(
        "click",
        () => show(index + 1, true),
        { signal },
      );
      toggle.addEventListener(
        "click",
        () => {
          paused = !paused;
          if (!paused) focused = false;
          sync();
        },
        { signal },
      );
      region.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          show(index + (event.key === "ArrowLeft" ? -1 : 1), true);
        },
        { signal },
      );
      let touchX = 0;
      let touchY = 0;
      region.addEventListener(
        "touchstart",
        (event) => {
          const touch = event.changedTouches[0];
          touchX = touch.clientX;
          touchY = touch.clientY;
        },
        { signal, passive: true },
      );
      region.addEventListener(
        "touchend",
        (event) => {
          const touch = event.changedTouches[0];
          const dx = touch.clientX - touchX;
          const dy = touch.clientY - touchY;
          if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy) * 1.25) return;
          show(index + (dx < 0 ? 1 : -1), true);
        },
        { signal, passive: true },
      );
      region.addEventListener(
        "focusin",
        () => {
          focused = true;
          sync();
        },
        { signal },
      );
      region.addEventListener(
        "focusout",
        (event) => {
          focused =
            event.relatedTarget instanceof Node &&
            region.contains(event.relatedTarget);
          sync();
        },
        { signal },
      );
      document.addEventListener("visibilitychange", sync, { signal });
      motion.addEventListener(
        "change",
        () => {
          paused = motion.matches;
          sync();
        },
        { signal },
      );
      const intersection = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.15 },
      );
      intersection.observe(this);
      const attributes = new MutationObserver(sync);
      for (
        let parent = this.parentElement;
        parent;
        parent = parent.parentElement
      )
        attributes.observe(parent, {
          attributes: true,
          attributeFilter: ["inert"],
        });
      sync();
      this.cleanup = () => {
        stop();
        controller.abort();
        intersection.disconnect();
        attributes.disconnect();
        this.cleanup = undefined;
      };
    }
  }
  if (!customElements.get("photo-slideshow"))
    customElements.define("photo-slideshow", PhotoSlideshow);
</script>
