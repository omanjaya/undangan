    {
      src: "/ornaments/theme-pack/keemasan-extra.webp",
      title: "Gerbang sebuah perjalanan",
      note: "Malam Keemasan · sambutan perayaan",
    },
    {
      src: "/ornaments/theme-pack/keemasan-accent.webp",
      title: "Dalam restu dan doa",
      note: "Malam Keemasan · detail keemasan",
    },
    {
      src: "/ornaments/theme-pack/keemasan-corner.webp",
      title: "Bersama dalam harmoni",
      note: "Malam Keemasan · dedaunan emas",
    },
  ],
  "pasir-putih": [
    {
      src: "/ornaments/theme-pack/pasir-corner.webp",
      title: "Mekar dalam tenang",
      note: "Pasir Putih · rangkaian floral",
    },
