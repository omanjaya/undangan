---
const { slug } = Astro.props as { slug: string };
---

<div
  id="guestbook"
  class="invite-guestbook"
  data-slug={slug}
  aria-live="polite"
>
  <p class="invite-guestbook-empty" data-i18n="wishes.loading">
    Memuat doa dan ucapan…
  </p>
</div>
<noscript>
  <p>
    Aktifkan JavaScript untuk melihat ucapan. Formulir konfirmasi tetap dapat
    digunakan.
  </p>
</noscript>
<script>
  import { tr } from "./i18n-client";
  const guestbook = document.querySelector<HTMLElement>("#guestbook");
  if (guestbook) {
    fetch(
      `/api/wishes?slug=${encodeURIComponent(guestbook.dataset.slug ?? "")}`,
    )
      .then(async (response) => {
        if (!response.ok) throw new Error("Gagal memuat ucapan.");
        return response.json();
      })
      .then(
        (data: {
          wishes: {
            name: string;
            message: string;
            createdAt: string;
            reply?: string;
          }[];
        }) => {
          guestbook.replaceChildren();
          if (!data.wishes.length) {
            const empty = document.createElement("p");
            empty.className = "invite-guestbook-empty";
            empty.dataset.i18n = "wishes.empty";
            empty.textContent = tr("wishes.empty");
            guestbook.append(empty);
          }
          data.wishes.forEach((wish) => {
            const card = document.createElement("article");
            card.className = "invite-wish";
            const name = document.createElement("h3");
            name.textContent = wish.name;
            const message = document.createElement("p");
            message.textContent = wish.message;
            const date = document.createElement("time");
            date.dateTime = wish.createdAt;
            date.textContent = new Intl.DateTimeFormat("id-ID", {
              dateStyle: "long",
            }).format(new Date(wish.createdAt));
            card.append(name, message);
            if (wish.reply) {
              const reply = document.createElement("div");
              reply.className = "invite-wish-reply";
              const label = document.createElement("strong");
              label.textContent = "Balasan mempelai";
              const text = document.createElement("p");
              text.textContent = wish.reply;
              reply.append(label, text);
              card.append(reply);
            }
            card.append(date);
            guestbook.append(card);
          });
        },
      )
      .catch(() => {
        guestbook.dataset.i18n = "wishes.error";
        guestbook.textContent = tr("wishes.error");
      });
  }
</script>
