---
interface Props {
  photo?: string;
  focus?: { x: number; y: number };
  bride: string;
  groom: string;
  ornament: string;
}
const { photo, focus = { x: 50, y: 50 }, bride, groom, ornament } = Astro.props;
---

<div class:list={["closing-portrait", { "has-photo": !!photo }]}>
  <img
    class="closing-portrait-ornament closing-portrait-back"
    src={ornament}
    alt=""
    aria-hidden="true"
    width="480"
    height="480"
    loading="lazy"
    decoding="async"
  />
  {photo ? (
    <div class="closing-portrait-frame">
      <img
        class="closing-portrait-photo"
        src={photo}
        alt={`${bride} dan ${groom}`}
        style={`object-position:${focus.x}% ${focus.y}%`}
        width="900"
        height="1000"
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="closing-portrait-monogram" aria-hidden="true">
      {bride.charAt(0)}
      <span>&</span>
      {groom.charAt(0)}
    </div>
  )}
  <img
    class="closing-portrait-ornament closing-portrait-front"
    src={ornament}
    alt=""
    aria-hidden="true"
    width="480"
    height="480"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .closing-portrait {
    position: relative;
    isolation: isolate;
    width: min(380px, 72vw);
    margin: 0 auto 48px;
  }
  .closing-portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 180px 180px 4px 4px;
    border: 1px solid var(--iv-line);
    padding: 8px;
    background: var(--iv-surface);
  }
  .closing-portrait-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: inherit;
  }
  .closing-portrait-ornament {
    position: absolute;
    width: 58%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }
  .closing-portrait-back {
    top: -8%;
    left: -24%;
    z-index: -1;
    opacity: 0.65;
    transform: rotate(-25deg);
  }
  .closing-portrait-front {
    bottom: -12%;
    right: -23%;
    z-index: 1;
    transform: rotate(150deg);
  }
  .closing-portrait-monogram {
    height: 170px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display, serif);
    font-size: 72px;
    font-weight: 400;
  }
  .closing-portrait-monogram span {
    font-size: 38px;
    font-style: italic;
    opacity: 0.55;
  }
  .closing-portrait:not(.has-photo) {
    width: min(270px, 65vw);
    margin-bottom: 28px;
  }
  :global(.invitation[data-theme="puri-emerald"]) .closing-portrait-frame {
    border-radius: 4px;
  }
  :global(.invitation[data-theme="senja-terracotta"]) .closing-portrait-frame {
    border-radius: 190px 190px 90px 90px;
  }
  :global(.invitation[data-ornament-density="minimal"]) .closing-portrait-back {
    display: none;
  }
  :global(.invitation[data-ornament-density="minimal"])
    .closing-portrait-front {
    width: 38%;
    opacity: 0.65;
  }
  @media (max-width: 600px) {
    .closing-portrait {
      width: min(280px, 65vw);
      margin-bottom: 38px;
    }
  }
</style>
