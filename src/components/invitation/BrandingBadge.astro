---
/**
 * Tanda merek untuk undangan pada paket gratis/percobaan.
 *
 * Pemakaian (dipasang sesuai entitlement, hanya bila paket tidak punya
 * `features.removeBranding`):
 *
 *   {!entitlements.features.removeBranding && <BrandingBadge />}
 *
 * Warna mengikuti variabel tema undangan (`--iv-*`), sehingga menyatu dengan
 * tema apa pun. Prop `href` opsional untuk mengarahkan ke halaman lain.
 *
 * Dipasang oleh `EditorialBotanical.astro` (prop `branding`) di footer undangan;
 * kredit lama `.invite-brand-credit` sudah dihapus.
 */
interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---

<a class="branding-badge" {href} rel="noopener">
  <span data-i18n="branding.made">Dibuat dengan Temu</span>{" "}
  <span aria-hidden="true">·</span>{" "}
  <u data-i18n="branding.cta">Buat undanganmu</u>
</a>

<style>
  .branding-badge {
    display: block;
    max-width: 1050px;
    margin: 36px auto 0;
    padding: 18px 20px 6px;
    border-top: 1px solid var(--iv-line, #dbd9cc);
    font-size: 11px;
    letter-spacing: 0.6px;
    text-align: center;
    color: var(--iv-muted, #77796e);
  }
  .branding-badge u {
    color: var(--iv-olive, #4c593f);
    text-underline-offset: 3px;
  }
  .branding-badge:hover u,
  .branding-badge:focus-visible u {
    color: var(--iv-gold, #a18a62);
  }
  .branding-badge:focus-visible {
    outline: 2px solid var(--iv-olive, #4c593f);
    outline-offset: 2px;
  }
</style>
