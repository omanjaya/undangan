# Copy to .env.production on your server and supply real values.
# Never use the example domain or credentials as-is.
APP_DOMAIN=undangan.example.com
APP_URL=https://undangan.example.com
# Admin (penjual) pertama; hanya dipakai membuat akun admin dan memigrasikan data lama saat
# belum ada pengguna. Setelah itu kata sandi dikelola lewat akun, bukan env.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_DATABASE_PASSWORD
WEB_PORT=4321
# Batas atas upload per ruang kerja pelanggan (paket dapat lebih kecil).
UPLOAD_STORAGE_MB=2048
# Opsional: notifikasi Telegram ke pemilik saat ada RSVP atau ucapan baru.
# Buat bot lewat @BotFather, kirim satu pesan ke bot, lalu ambil chat id dari getUpdates.
# Dikosongkan = notifikasi nonaktif.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (atur ulang kata sandi). Tanpa SMTP: development mencatat email di konsol server;
# production tidak mengirim dan halaman lupa kata sandi mengarahkan ke WhatsApp admin.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=Temu <halo@example.com>

# Situs publik: tampil di footer, halaman legal/kontak, tombol WhatsApp, SEO.
# Isi dengan data bisnis yang sebenarnya. SITE_URL jatuh ke APP_URL bila kosong.
SITE_NAME=Temu
SITE_URL=https://undangan.example.com
CONTACT_WHATSAPP=6281234567890
CONTACT_EMAIL=halo@undangan.example.com
BUSINESS_NAME=Nama Usaha Anda
BUSINESS_ADDRESS=Alamat usaha Anda, Kota, Indonesia
