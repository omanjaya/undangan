# Local development only. Replace credentials before deployment.
# Optional when using a separate local PostgreSQL server. Compose supplies its own URL.
# DATABASE_URL=postgresql://undangan:undangan_local@localhost:5432/undangan
POSTGRES_PASSWORD=undangan_local
# Admin pertama: dipakai hanya saat belum ada pengguna (dev tanpa DATABASE_URL membuat akun ini otomatis).
# Pelanggan lain mendaftar sendiri lewat /daftar.
OWNER_EMAIL=owner@undangan.local
OWNER_PASSWORD=demo-undangan-2026
# Required for production behind an HTTPS reverse proxy; omit during local/LAN testing.
# APP_URL=https://undangan.example.com
WEB_PORT=4321
WEB_BIND_ADDRESS=0.0.0.0
# Opsional: notifikasi Telegram ke pemilik saat ada RSVP atau ucapan baru.
# Buat bot lewat @BotFather, kirim satu pesan ke bot, lalu ambil chat id dari getUpdates.
# Dikosongkan = notifikasi nonaktif.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
