{
  "name": "temu-undangan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --import tsx db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx db/seed.ts",
    "format": "prettier --write src db *.mjs *.json",
    "format:check": "prettier --check src db *.mjs *.json",
    "deploy:check": "node --env-file=.env.production scripts/preflight.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/noto-serif-balinese": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "astro": "^7.3.3",
    "file-type": "^22.1.1",
    "postgres": "^3.4.7",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
